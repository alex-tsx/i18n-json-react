{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "i18n-json-react Android string resources",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultLanguage", "resources"],
  "properties": {
    "$schema": {"type": "string"},
    "root": {"type": "string", "description": "Paths are relative to this root, itself relative to the config file."},
    "defaultLanguage": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "locales": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "resources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["outputDir", "dictionaries", "strings"],
        "properties": {
          "outputDir": {"type": "string", "minLength": 1, "description": "Android res directory relative to root."},
          "fileName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.xml$", "default": "i18n_json_react.xml"},
          "dictionaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "strings": {
            "type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
            "additionalProperties": {
              "oneOf": [
                {"type": "string"},
                {"type": "object", "additionalProperties": false, "required": ["key"], "properties": {"key": {"type": "string"}, "formatted": {"type": "boolean"}}}
              ]
            }
          }
        }
      }
    }
  }
}
