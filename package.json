{
  "name": "i18n-json-react",
  "version": "0.1.0",
  "description": "Typed, feature-local JSON translations for React, with optional per-language Vite and Webpack bundles.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./webpack": {
      "types": "./webpack/index.d.cts",
      "default": "./webpack/index.cjs"
    },
    "./vite": {
      "types": "./vite/index.d.cts",
      "default": "./vite/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "webpack",
    "vite",
    "bundlers",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc -p test/tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "webpack": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-tsx/i18n-json-react.git"
  },
  "bugs": {
    "url": "https://github.com/alex-tsx/i18n-json-react/issues"
  },
  "homepage": "https://github.com/alex-tsx/i18n-json-react#readme",
  "keywords": [
    "i18n",
    "react",
    "json",
    "typescript",
    "localization",
    "webpack",
    "vite",
    "vite-plugin"
  ],
  "license": "UNLICENSED"
}
