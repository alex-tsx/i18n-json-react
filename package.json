{
  "name": "i18n-json-react",
  "version": "1.0.0",
  "description": "Typed, feature-local JSON translations for React and React Native, with Vite, Webpack and Android/iOS Metro extraction.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/core.d.ts",
        "default": "./dist/esm/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    },
    "./webpack": {
      "types": "./webpack/index.d.cts",
      "default": "./webpack/index.cjs"
    },
    "./vite": {
      "types": "./vite/index.d.cts",
      "default": "./vite/index.cjs"
    },
    "./native/android": {
      "types": "./native/android/index.d.cts",
      "default": "./native/android/index.cjs"
    },
    "./native/android/expo": {
      "types": "./native/android/expo.d.cts",
      "default": "./native/android/expo.cjs"
    },
    "./native/android/metro": {
      "types": "./native/android/metro.d.cts",
      "default": "./native/android/metro.cjs"
    },
    "./package.json": "./package.json",
    "./native": {
      "types": "./native/index.d.cts",
      "default": "./native/index.cjs"
    },
    "./native/expo": {
      "types": "./native/expo.d.cts",
      "default": "./native/expo.cjs"
    },
    "./native/metro": {
      "types": "./native/metro.d.cts",
      "default": "./native/metro.cjs"
    },
    "./native/ios": {
      "types": "./native/ios/index.d.cts",
      "default": "./native/ios/index.cjs"
    },
    "./native/ios/expo": {
      "types": "./native/ios/expo.d.cts",
      "default": "./native/ios/expo.cjs"
    },
    "./native/ios/metro": {
      "types": "./native/ios/metro.d.cts",
      "default": "./native/ios/metro.cjs"
    },
    "./native/android/resources": {
      "types": "./native/android/resources.d.cts",
      "default": "./native/android/resources.cjs"
    },
    "./native/android/plugin": {
      "types": "./native/android/plugin.d.cts",
      "default": "./native/android/plugin.cjs"
    },
    "./native/android/resources.schema.json": "./native/android/resources.schema.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "webpack",
    "vite",
    "bundlers",
    "native",
    "README.md"
  ],
  "sideEffects": false,
  "bin": {
    "i18n-json-react-android": "./native/android/cli.cjs",
    "i18n-json-react-native": "./native/cli.cjs",
    "i18n-json-react-ios": "./native/ios/cli.cjs",
    "i18n-json-react-android-resources": "./native/android/resources-cli.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "npm run build && tsc -p test/tsconfig.json && tsc -p test/tsconfig.registered.json && tsc -p test/tsconfig.languages-only.json && tsc -p test/tsconfig.registration-commonjs.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "expo-asset": ">=12.0.0",
    "expo-file-system": ">=19.0.0",
    "metro-config": "^0.83.0",
    "vite": "^7.0.0 || ^8.0.0",
    "webpack": "^5.0.0",
    "@expo/config-plugins": ">=54.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "expo-asset": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    },
    "metro-config": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.81.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "typescript": "^6.0.3",
    "metro": "^0.83.8",
    "metro-config": "^0.83.8",
    "vite": "^8.3.5",
    "webpack": "^5.0.0",
    "@expo/config-plugins": "~54.0.6"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-tsx/i18n-json-react.git"
  },
  "bugs": {
    "url": "https://github.com/alex-tsx/i18n-json-react/issues"
  },
  "homepage": "https://github.com/alex-tsx/i18n-json-react#readme",
  "keywords": [
    "i18n",
    "react",
    "json",
    "typescript",
    "localization",
    "webpack",
    "vite",
    "vite-plugin",
    "react-native",
    "android",
    "expo",
    "metro",
    "ios"
  ],
  "license": "MIT"
}
